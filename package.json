{
  "name": "@hy_ong/react-hooks",
  "version": "0.1.0",
  "description": "Headless feedback lifecycle hooks for React",
  "keywords": [
    "hy_ong",
    "react",
    "hooks",
    "react-hooks"
  ],
  "homepage": "https://github.com/hy-ong/react-hooks#readme",
  "bugs": {
    "url": "https://github.com/hy-ong/react-hooks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hy-ong/react-hooks.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Ong Hoe Yuan",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "check": "npm run lint && npm run typecheck && npm run test:run",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "release:dry-run": "npm publish --dry-run",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
